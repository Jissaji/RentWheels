PORT=5000
NODE_ENV=development

# ─── Database – MySQL / RDBMS ────────────────────────────────────────────────
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=car_rental_db

# If MySQL is not running locally the backend falls back automatically to
# an embedded SQLite database so development always works offline.
DB_FALLBACK=true

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Replace with a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRES_IN=7d
